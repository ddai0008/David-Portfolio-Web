# Ignore all files in the .context directory (Conversation Memory and Context)
.context/*

# Next.js / Node (from create-next-app)
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Impeccable design skills. Installed per machine with `npx impeccable install` (the engine binary
# alone is 22 MB), so they are not vendored here. Its project files under .impeccable/ and the
# PRODUCT.md and DESIGN.md it writes are committed.
/.claude/skills/impeccable/
/.claude/agents/impeccable-*.md
# Critique snapshots are local run history; the ignore list beside them records decisions.
/.impeccable/critique/*
!/.impeccable/critique/ignore.md
